{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/.api-tmp",
  "readme": "none",
  "githubPages": false,
  "outputFileStrategy": "modules",
  "excludeExternals": true,
  "externalPattern": ["**/node_modules/**"],
  "excludeInternal": true,
  "excludeProtected": true,
  "disableSources": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "externalSymbolLinkMappings": {
    "@dpup/meshcore-ts": {
      "MeshCoreClient": "https://github.com/dpup/meshcore-ts/blob/main/docs/api.md",
      "MeshCoreError": "https://github.com/dpup/meshcore-ts/blob/main/docs/api.md",
      "Contact": "https://github.com/dpup/meshcore-ts/blob/main/docs/api.md"
    },
    "@modelcontextprotocol/sdk": {
      "McpServer": "https://github.com/modelcontextprotocol/typescript-sdk"
    }
  },
  "validation": { "notExported": false, "invalidLink": true, "notDocumented": false }
}
